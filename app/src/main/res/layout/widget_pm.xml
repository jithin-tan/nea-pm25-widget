<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="7dp" android:background="@drawable/widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="NEA PM2.5 · 1h (µg/m³)" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true"/>
<TextView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="23dp" android:gravity="center" android:text="↻" android:textSize="18sp" android:textColor="#B7DEFF" android:contentDescription="Refresh readings"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sg_map_widget" android:scaleType="fitCenter" android:contentDescription="Stylized Singapore map"/>
<LinearLayout android:layout_width="53dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="center_horizontal|top" android:background="@drawable/reading_bg" android:paddingTop="1dp" android:paddingBottom="1dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="North" android:textSize="7sp" android:textColor="#D5E4EF" android:includeFontPadding="false"/>
<TextView android:id="@+id/north" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="53dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="left|center_vertical" android:background="@drawable/reading_bg" android:paddingTop="1dp" android:paddingBottom="1dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="West" android:textSize="7sp" android:textColor="#D5E4EF" android:includeFontPadding="false"/>
<TextView android:id="@+id/west" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="53dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="center" android:background="@drawable/reading_bg" android:paddingTop="1dp" android:paddingBottom="1dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Central" android:textSize="7sp" android:textColor="#D5E4EF" android:includeFontPadding="false"/>
<TextView android:id="@+id/central" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="53dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="right|center_vertical" android:background="@drawable/reading_bg" android:paddingTop="1dp" android:paddingBottom="1dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="East" android:textSize="7sp" android:textColor="#D5E4EF" android:includeFontPadding="false"/>
<TextView android:id="@+id/east" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="53dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="center_horizontal|bottom" android:background="@drawable/reading_bg" android:paddingTop="1dp" android:paddingBottom="1dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="South" android:textSize="7sp" android:textColor="#D5E4EF" android:includeFontPadding="false"/>
<TextView android:id="@+id/south" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
</FrameLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right" android:text="Loading" android:textSize="8sp" android:textColor="#B9C9D9" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>